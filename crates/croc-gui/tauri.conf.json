{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "crocw-rs",
  "version": "0.1.0",
  "identifier": "cn.sumitm.crocw",
  "build": {
    "beforeDevCommand": "pnpm --prefix ui run dev",
    "beforeBuildCommand": "pnpm --prefix ui run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Crocw",
        "width": 920,
        "height": 660,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Send files anywhere, simply and securely.",
    "longDescription": "croc-rs: a Rust rewrite of croc. End-to-end encrypted file transfer between any two computers, with a self-hostable relay."
  }
}
